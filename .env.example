# Sorftime upstream credential.
#
# Prefer `sorftime auth login`, which stores the Account-SK in the OS keychain or a
# mode-0600 credential file. Use this variable only for CI and container runs, and
# never commit a real Account-SK.
SORFTIME_ACCOUNT_SK=

SORFTIME_BASE_URL=https://standardapi.sorftime.com/api/

# Default marketplace when neither --domain nor `sorftime config set domain` applies.
SORFTIME_DOMAIN=us

# Optional CLI defaults; command-line flags always win.
# SORFTIME_TIMEOUT=60
# SORFTIME_RETRIES=0
# SORFTIME_OUTPUT=json
