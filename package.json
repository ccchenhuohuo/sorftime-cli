{
  "name": "sorftime-cli",
  "version": "2.0.0",
  "description": "Complete Sorftime Enterprise API CLI with an AI Skill for routing and interpretation",
  "private": true,
  "type": "module",
  "bin": {
    "sorftime-team": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sorftime",
    "agent-skill",
    "amazon",
    "seller",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccchenhuohuo/sorftime-cli.git"
  },
  "homepage": "https://github.com/ccchenhuohuo/sorftime-cli#readme",
  "bugs": {
    "url": "https://github.com/ccchenhuohuo/sorftime-cli/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "commander": "^14.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.14",
    "eslint": "^9.31.0",
    "tsx": "^4.20.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.7.0"
}
